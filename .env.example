# Server-side only. Never put this key in src/ or upload .env to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_ENV=development
PORT=4173
DATABASE_PATH=.local/careerquest.sqlite3
# Required for a new production database; use different passwords (12+ chars).
ADMIN_PASSWORD=
EMPLOYEE_PASSWORD=
# On a public HTTPS host set APP_ENV=production and PUBLIC_ORIGIN to its URL.
PUBLIC_ORIGIN=
# Optional email provider. Leave blank until a real SMTP account is available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
SMTP_TLS=true
